# ============================================================
# Environment Variables — Copy to .env and fill in your keys
# ============================================================

# --- App Settings ---
APP_SECRET_KEY=change_this_to_a_random_secret_string_at_least_32_chars
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- JWT Auth ---
JWT_SECRET_KEY=another_random_secret_for_jwt_tokens
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080        # 7 days

# --- Claude / Anthropic API ---
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Spotify API ---
# Get at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# --- YouTube Data API v3 ---
# Get at: https://console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./emotion_music.db

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# --- Model Settings ---
# Options: vader (fast, no download), transformers (accurate, downloads ~500MB)
TEXT_EMOTION_MODEL=vader
# Options: svm (lightweight), deep (requires more RAM)
VOICE_EMOTION_MODEL=svm
